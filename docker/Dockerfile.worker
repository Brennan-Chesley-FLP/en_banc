# Worker image: runs JKent scrapes via Prefect's stock process worker.
#
# Build context is the en_banc repo root (.); juriscraper and jkent are pulled
# in as named build contexts (they live as sibling repos). docker-compose.yml
# wires these up via build.additional_contexts; for a manual build pass them
# explicitly (run from the en_banc root):
#
#   podman build \
#       --build-context juriscraper=../juriscraper \
#       --build-context jkent=../jkent \
#       -f docker/Dockerfile.worker -t en-banc-worker .
#
# (docker buildx uses the same --build-context flags.)
#
# jkent and juriscraper are installed *editable* against /src/jkent and
# /src/juriscraper, and the app code lives at /app. docker-compose.yml mounts
# the host checkouts over all three paths, and every flow run is a fresh
# subprocess (`python -m prefect.engine`) that imports from scratch — so code
# changes in any of the three repos apply on the *next flow run*, no image
# rebuild or container restart needed. The baked-in copies only serve runs when
# the mounts are absent.
#
# A rebuild is still required when *dependencies* change (a pyproject gains or
# bumps a package) or to refresh the browser engine — mounts carry code only.
#
# Browser support (camoufox/Firefox, for FF_ALIKE scrapers) is off by default
# to keep the image lean. Opt in with --build-arg INSTALL_BROWSERS=1:
#
#   mise run build-worker -- --build-arg INSTALL_BROWSERS=1

FROM prefecthq/prefect:3-python3.13

# 0 = plain-HTTP scrapers only (lean); 1 = also install the Firefox-alike
# browser engine for FF_ALIKE scrapers (heavy: pulls a full browser).
ARG INSTALL_BROWSERS=0

# curl: the entrypoint polls the Prefect server health endpoint.
# procps: the entrypoint uses pkill to signal flow-run subprocesses to drain.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl procps \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Sibling source trees at the exact paths the compose mounts shadow. jkent goes
# first so juriscraper's unconstrained `jkent` dependency resolves to it.
COPY --from=jkent . /src/jkent
COPY --from=juriscraper . /src/juriscraper

# jkent[operational] (DB engine + HTTP/browser transports) and juriscraper,
# both editable so site-packages points at /src — where the compose mounts put
# the live host checkouts. (juriscraper's own `[tool.uv.sources]` already pins
# jkent to `../jkent` editable, which is exactly /src/jkent here.) Plus the
# Prefect/S3 runtime deps the flows need. psycopg2-binary bundles its own
# libpq. The OpenTelemetry SDK + exporter + instrumentors ship in the image:
# jkent depends only on the OTel API and stays no-op until an SDK is installed
# by the flow process (see EN_BANC_OTEL.md). Kept in sync with pyproject.toml.
RUN pip install --no-cache-dir uv \
    && uv pip install --system --no-cache \
    --editable "/src/jkent[operational]" \
    --editable /src/juriscraper \
    prefect-aws \
    boto3 \
    psycopg2-binary \
    opentelemetry-sdk \
    opentelemetry-exporter-otlp \
    opentelemetry-instrumentation-httpx \
    opentelemetry-instrumentation-sqlalchemy \
    opentelemetry-instrumentation-botocore \
    opentelemetry-instrumentation-asyncio

# Browser engine for Firefox-alike (FF_ALIKE) scrapers. Skipped unless
# INSTALL_BROWSERS=1 — it's a heavy layer (full browser download).
RUN if [ "$INSTALL_BROWSERS" = "1" ]; then \
        playwright install-deps firefox && python -m camoufox fetch; \
    else \
        echo "Skipping browser install (INSTALL_BROWSERS=$INSTALL_BROWSERS)"; \
    fi

# Application code (the flows). Deployments carry a set_working_directory
# pull step targeting /app, so each flow-run subprocess chdirs here and loads
# the entrypoint from this tree (or the compose mount shadowing it).
COPY . /app
WORKDIR /app
RUN chmod +x /app/docker/worker-entrypoint.sh \
    && cp /app/docker/worker-entrypoint.sh /worker-entrypoint.sh

ENTRYPOINT ["/worker-entrypoint.sh"]
